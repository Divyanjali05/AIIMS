# AIIMS Backend Environment Configuration Template
# Copy this file to .env and populate with your credentials. NEVER commit .env to version control.

# Server port for Express backend (default: 5001)
PORT=5001

# Runtime environment ('development', 'production', or 'test')
NODE_ENV=development

# MongoDB Atlas or local connection string URI (e.g. mongodb://localhost:27017/aiims or mongodb+srv://<user>:<password>@cluster.mongodb.net/aiims)
MONGODB_URI=mongodb://localhost:27017/aiims

# Cryptographic signing secret for JWT tokens (must be 32+ characters in production)
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters_here

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Google Gemini API key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini model identifier (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude API key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model identifier for tool assessments (default: claude-3-5-sonnet-20241022)
AI_TOOL_ASSESSMENT_MODEL=claude-3-5-sonnet-20241022

# Preferred AI provider ('gemini' or 'anthropic')
AI_PROVIDER=gemini

# Flag to trigger automated AI tool catalog discovery on backend startup ('true' or 'false')
RUN_DISCOVERY_ON_START=false

# Maximum auth requests allowed per rate limit window (default: 15)
AUTH_RATE_LIMIT_MAX=15

# Duration of auth rate limit window in milliseconds (default: 900000 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Optional custom GitHub feed URL for automated tool discovery
GITHUB_AI_FEED_URL=https://api.github.com/repos/continuedev/continue/releases/latest

# Optional custom HuggingFace feed URL for automated tool discovery
HUGGINGFACE_FEED_URL=https://huggingface.co/api/trending

# AES-256 encryption key for TOTP secrets stored at rest (staff 2FA).
# Must be exactly 64 hex characters (= 32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production. A dev-only fallback is used when this is absent in development.
TOTP_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here_generate_with_crypto

# Optional Sentry DSN for backend error monitoring (leave empty to disable)
SENTRY_DSN=

# Support contact email address displayed across legal policies and in-app support
SUPPORT_EMAIL=support@aiims.education


