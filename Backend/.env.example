# AIIMS Backend Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL.

# Server Port & Environment Mode
PORT=5001
NODE_ENV=development

# JWT Authentication Signing Key
# In production, must be a cryptographically secure 256-bit random string (min 32 characters).
# Example generation: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_random_characters_required

# MongoDB Database Connection
# Atlas URI format: mongodb+srv://<username>:<password>@cluster.mongodb.net/aiims?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://placeholder_user:placeholder_password@cluster.mongodb.net/aiims?retryWrites=true&w=majority

# External AI Provider API Keys
# Anthropic Claude 3.5 Sonnet API Key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key

# Google Gemini API Key (from https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyPlaceholderGeminiKey
GEMINI_MODEL=gemini-3.5-flash

# CORS Allowed Origins (Comma-separated list of web origins allowed to access the API)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Rate Limiting Configuration
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Whether to run full AI tool discovery pass on server start (set to true to enable)
RUN_DISCOVERY_ON_START=false
