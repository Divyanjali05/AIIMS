{
  "name": "aiims-backend",
  "version": "1.0.0",
  "description": "AIIMS Backend API - AI Intelligence & Mentoring System",
  "main": "dist/server.js",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "migrate:passwords": "ts-node src/scripts/migratePasswords.ts",
    "seed:tools": "ts-node src/scripts/seedToolCatalog.ts",
    "test:phase2a": "ts-node src/scripts/testPhase2A.ts",
    "test:security": "ts-node src/scripts/testPhase1Security.ts",
    "test:scoring": "ts-node src/scripts/runScoringTests.ts",
    "test:unit": "vitest run --config ../vitest.config.ts src/services/__tests__",
    "test:entitlements": "ts-node --transpile-only src/scripts/testPhase3Entitlements.ts",
    "secrets:scan": "gitleaks detect --redact --config ../.gitleaks.toml",
    "secrets:protect": "gitleaks protect --staged --redact --config ../.gitleaks.toml",
    "secrets:history": "gitleaks detect --redact --log-opts=\"--all --full-history\" --config ../.gitleaks.toml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.2"
  }
}
