#!/bin/sh

# 1. AIIMS Security Guard: Enforce Gitleaks secret detection before any commit
if ! command -v gitleaks >/dev/null 2>&1; then
    # Dynamically locate Gitleaks across common installation paths on macOS, Linux, and Windows
    for candidate_dir in \
        "/opt/homebrew/bin" \
        "/usr/local/bin" \
        "$HOME/.local/bin" \
        "$HOME/bin" \
        "$LOCALAPPDATA/Microsoft/WinGet/Packages/Gitleaks.Gitleaks"* \
        "$LOCALAPPDATA/Programs/gitleaks" \
        "$USERPROFILE/scoop/shims" \
        "$ALLUSERSPROFILE/chocolatey/bin"; do
        if [ -d "$candidate_dir" ]; then
            PATH="$PATH:$candidate_dir"
            if command -v gitleaks >/dev/null 2>&1; then
                break
            fi
        fi
    done
fi

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact --config .gitleaks.toml
    exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo "❌ [SECURITY FATAL] Gitleaks detected sensitive credentials in staged files!"
        echo "Commit aborted. Please review staged changes or remove credentials."
        exit 1
    fi
else
    echo "⚠️ [SECURITY WARNING] Gitleaks is not installed or not in PATH. Skipping secret pre-commit hook."
fi

# 2. Run lint-staged on staged files
npx lint-staged
