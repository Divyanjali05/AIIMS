{
  "name": "aiims-frontend",
  "version": "1.0.0",
  "description": "AIIMS Mobile App Frontend - AI Intelligence & Mentoring System",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "npx ts-node --transpile-only ../Backend/src/scripts/runFrontendTests.ts",
    "test:unit": "vitest run --config ../vitest.config.ts",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "cap:open": "cap open android",
    "secrets:scan": "gitleaks detect --redact --config ../.gitleaks.toml",
    "secrets:protect": "gitleaks protect --staged --redact --config ../.gitleaks.toml"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.169.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.2.11"
  }
}
