# AIIMS Frontend Environment Configuration Template
# Copy this file to .env and populate with your settings. NEVER commit .env to version control.

# Base URL for the AIIMS backend API (defaults to '/api' for Vite reverse-proxy; use 'http://10.0.2.2:5001/api' for Android Emulator)
VITE_API_BASE_URL=/api

# Optional: Set to 'true' to allow unencrypted cleartext HTTP traffic during local mobile development (default: false)
CAPACITOR_DEV_CLEARTEXT=false

# Optional Sentry DSN for frontend error monitoring (leave empty to disable)
VITE_SENTRY_DSN=

# Support contact email address (placeholder read from SUPPORT_EMAIL / VITE_SUPPORT_EMAIL)
VITE_SUPPORT_EMAIL=support@aiims.education


